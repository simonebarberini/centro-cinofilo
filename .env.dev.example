# ── Centro Cinofilo – Variabili d'ambiente sviluppo ──────────────────────────
# Copia questo file in .env.dev e adatta se necessario.
# MAI committare .env.dev con valori reali!
#
# Avvio sviluppo locale:
#   1. docker compose --env-file .env.dev -f infra/docker/dev/docker-compose.yml up -d
#   2. cd backend && mvn spring-boot:run
#   3. cd frontend && npm run dev
# ─────────────────────────────────────────────────────────────────────────────

# Database (postgres avviato via Docker)
POSTGRES_DB=cinofilo
POSTGRES_USER=cinofilo
POSTGRES_PASSWORD=cinofilo

# Backend Spring Boot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cinofilo
DB_USER=cinofilo
DB_PASSWORD=cinofilo
JWT_SECRET=dev-secret-key-minimum-256-bits-for-hs256-algorithm-change-in-production
JWT_EXPIRATION_MS=28800000
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
