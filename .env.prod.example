# ── Centro Cinofilo – Variabili d'ambiente produzione ────────────────────────
# Copia questo file in .env.prod e compila con valori reali.
# MAI committare .env.prod con valori reali!
#
# Avvio produzione (dalla root del progetto):
#   docker compose \
#     --env-file .env.prod \
#     -f infra/docker/prod/db.yml \
#     -f infra/docker/prod/backend.yml \
#     -f infra/docker/prod/frontend.yml \
#     up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# Database
POSTGRES_DB=cinofilo
POSTGRES_USER=cinofilo
POSTGRES_PASSWORD=change-me-strong-password

# Backend
JWT_SECRET=change-me-super-strong-jwt-secret-minimum-512-bits-64-bytes-random-now
JWT_EXPIRATION_MS=28800000

# Platform admin bootstrap — unico utente ADMIN_APP creato all'avvio (vedi ADR-017)
PLATFORM_ADMIN_USERNAME=change-me
PLATFORM_ADMIN_EMAIL=change-me@yourdomain.com
PLATFORM_ADMIN_PASSWORD=change-me-strong-password

# Frontend (porta esposta sull'host)
FRONTEND_PORT=80
