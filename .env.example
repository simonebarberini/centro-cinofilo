# ══════════════════════════════════════════════════════════════════════════════
# Centro Cinofilo — Variabili d'ambiente PRODUZIONE
#
# Copia questo file in .env (MAI committare .env con valori reali) e compila.
# Usato da: infra/docker/prod/docker-compose.yml
#
# Avvio produzione (dalla root del progetto):
#   docker compose --env-file .env -f infra/docker/prod/docker-compose.yml up -d --build
#
# Genera un JWT secret sicuro (>= 64 byte / 512 bit per HS512):
#   openssl rand -hex 64
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=cinofilo
POSTGRES_USER=cinofilo
POSTGRES_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# OBBLIGATORIA, nessun default. Minimo 64 byte (512 bit) per HS512.
JWT_SECRET=
# Opzionale. Default: 28800000 (8 ore)
JWT_EXPIRATION_MS=28800000

# ── Platform admin bootstrap ──────────────────────────────────────────────────
# Unico utente ADMIN_APP creato all'avvio (vedi ADR-017). Obbligatorie, nessun default.
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ── Mail (SMTP) ───────────────────────────────────────────────────────────────
# Obbligatorie in produzione, nessun default (vedi sezione "Configurazione email" nel README).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── App ───────────────────────────────────────────────────────────────────────
# URL pubblico del frontend, usato nei link delle email (verifica, reset password).
APP_BASE_URL=
# Lista separata da virgole delle origin autorizzate per CORS (es. https://app.tuodominio.it).
CORS_ALLOWED_ORIGINS=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Porta esposta sull'host per il container Nginx. Default: 80
FRONTEND_PORT=80
