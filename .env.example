# ══════════════════════════════════════════════════════════════════════════════
# Centro Cinofilo — Environment Variables Reference
#
# Copy this file to .env (never commit .env) and fill in the values.
# In production, set these as environment variables in your deployment platform.
#
# Generate a secure JWT secret (>= 64 bytes / 512 bits for HS512):
#   openssl rand -hex 64
# ══════════════════════════════════════════════════════════════════════════════

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED. Minimum 64 bytes (512 bits) for HS512. No default — app will not start without this.
JWT_SECRET=

# Optional. JWT expiration in milliseconds. Default: 28800000 (8 hours).
# JWT_EXPIRATION_MS=28800000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default: http://localhost:4200 (dev only — always set this in production).
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cinofilo
DB_USER=cinofilo
DB_PASSWORD=

# ── Mail (SMTP) ───────────────────────────────────────────────────────────────
# Development: use Mailhog → docker run -d -p 1025:1025 -p 8025:8025 mailhog/mailhog
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender address shown in outgoing emails (production only).
# MAIL_FROM=noreply@yourdomain.com

# ── Application ───────────────────────────────────────────────────────────────
# Public URL of the frontend. Used in email links (verification, password reset).
# Default: http://localhost:4200
# APP_BASE_URL=https://app.yourdomain.com

# ── Server ────────────────────────────────────────────────────────────────────
# Optional. Default: 8080
# SERVER_PORT=8080

# ── Flyway ────────────────────────────────────────────────────────────────────
# Optional. Set to false to skip migrations (not recommended in production).
# FLYWAY_ENABLED=true
