# ── Centro Cinofilo – Variabili d'ambiente sviluppo ──────────────────────────
# File tracciato in git: contiene solo valori non sensibili per lo sviluppo
# locale, pronti all'uso senza modifiche.
#
# Avvio sviluppo locale:
#   1. docker compose --env-file .env.dev -f infra/docker/dev/docker-compose.yml up -d
#   2. cd backend && mvn spring-boot:run -Dspring-boot.run.profiles=dev
#   3. cd frontend && npm start
# ─────────────────────────────────────────────────────────────────────────────

# Database (postgres avviato via Docker)
POSTGRES_DB=cinofilo
POSTGRES_USER=cinofilo
POSTGRES_PASSWORD=cinofilo

# Backend Spring Boot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cinofilo
DB_USER=cinofilo
DB_PASSWORD=cinofilo
JWT_SECRET=dev-only-secret-key-for-local-development-not-for-production-hs512-64b
JWT_EXPIRATION_MS=28800000
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
