# ── Centro Cinofilo – Variabili ambiente local-prod ───────────────────────────
# Copia in .env.local-prod e adatta se necessario.
# MAI committare .env.local-prod con valori reali!
#
# Avvio (dalla root del progetto):
#   docker compose --env-file .env.local-prod -f infra/docker/local-prod/docker-compose.yml up -d --build
#
# MailHog Web UI (leggi le email):
#   http://localhost:8025
#
# PostgreSQL (DBeaver):
#   host: localhost  porta: 5433  db/user/pass: quelli qui sotto
# ─────────────────────────────────────────────────────────────────────────────

# Database
POSTGRES_DB=cinofilo
POSTGRES_USER=cinofilo
POSTGRES_PASSWORD=cinofilo-local

# Backend – JWT (cambia con una stringa random di almeno 512 bit / 64 byte)
JWT_SECRET=local-prod-jwt-secret-minimum-512-bits-64-bytes-please-change-this-now
JWT_EXPIRATION_MS=28800000

# Mail (MailHog viene configurato automaticamente dal compose)
MAIL_FROM=noreply@centro-cinofilo.local
APP_BASE_URL=http://localhost

# Porta frontend sull'host (default 80)
FRONTEND_PORT=80
